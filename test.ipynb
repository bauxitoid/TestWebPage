import matplotlib.pyplot as plt

v0 = float(input("Zadej počáteční rychlost [m/s]: "))
a = float(input("Zadej zrychlení [m/s^2]: "))
t = [i for i in range(0, 11)]
s = [v0 * ti + 0.5 * a * ti**2 for ti in t]

plt.plot(t, s)
plt.xlabel("Čas [s]")
plt.ylabel("Dráha [m]")
plt.title("Pohyb tělesa")
plt.grid()
plt.show()
